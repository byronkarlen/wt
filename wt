wt() {
  _wt_usage() {
    cat <<EOF
usage:
  wt                        show branches and worktree status
  wt [go] <#|name|branch>   go to worktree (creates if branch exists)
  wt [go] 0|home            go to main repo
  wt [go] -                 go to previous worktree
  wt new [name]             create new worktree (branch: worktree-<name>)
                              (no name: move current branch from home)
  wt rm <#|name|branch>     remove worktree
  wt rm -b <#|name|branch>  remove worktree and delete branch
  wt list                   list worktrees (raw)
  wt status                 show branches and worktree status
EOF
  }

  # Handle help before git repo check so it works anywhere
  if [[ "$1" == "-h" || "$1" == "--help" || "$1" == "help" ]]; then
    _wt_usage
    return 0
  fi

  local home_repo wt_base target branch

  # Get home repo (first worktree is always the main one)
  home_repo=$(git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //')

  [[ -z "$home_repo" ]] && {
    echo "wt: not inside a git repository" >&2
    _wt_usage >&2
    return 1
  }

  wt_base="$home_repo/.claude/worktrees"

  # Generate a random worktree name (adjective-animal)
  _wt_random_name() {
    local adjectives=(quick bright calm cool dark fast keen mild neat warm bold dry fair flat free glad pure raw safe thin wide)
    local animals=(ant bat bee cat cow deer duck eel elk fox frog goat hawk hen ibis jay koi lynx mole newt owl pig ram seal swan toad vole wasp wolf wren yak)
    local name
    while true; do
      name="${adjectives[$((RANDOM % ${#adjectives[@]} + 1))]}-${animals[$((RANDOM % ${#animals[@]} + 1))]}"
      [[ ! -d "$wt_base/$name" ]] && break
    done
    echo "$name"
  }

  # Find worktree directory by branch name
  _wt_find_by_branch() {
    local target_branch="$1"
    git worktree list --porcelain | awk -v branch="refs/heads/$target_branch" -v base="$wt_base" '
      /^worktree / { path = substr($0, 10) }
      /^branch / && $2 == branch && index(path, base) == 1 { print path; exit }
    '
  }

  # Get branch name for a worktree path
  _wt_get_branch() {
    local wt_path="$1"
    git worktree list --porcelain | awk -v path="$wt_path" '
      /^worktree / { current = substr($0, 10) }
      /^branch / && current == path { sub("refs/heads/", ""); print $2; exit }
    '
  }

  # Resolve a target to a worktree path
  _wt_resolve_target() {
    local target="$1"

    # 1. Direct name match in .claude/worktrees/<target>/
    if [[ -d "$wt_base/$target" ]]; then
      echo "$wt_base/$target"
      return
    fi

    # 2. Numeric index into alphabetically-sorted dirs
    if [[ "$target" =~ ^[0-9]+$ ]]; then
      local -a sorted_dirs
      if [[ -d "$wt_base" ]]; then
        sorted_dirs=($(ls -1 "$wt_base" 2>/dev/null | sort))
      fi
      local idx=$target
      if (( idx >= 1 && idx <= ${#sorted_dirs[@]} )); then
        echo "$wt_base/${sorted_dirs[$idx]}"
        return
      fi
    fi

    # 3. Branch name lookup
    local found=$(_wt_find_by_branch "$target")
    if [[ -n "$found" ]]; then
      echo "$found"
      return
    fi

    # 4a. Try with worktree- prefix added
    found=$(_wt_find_by_branch "worktree-$target")
    if [[ -n "$found" ]]; then
      echo "$found"
      return
    fi

    # 4b. Try with worktree- prefix stripped (as dir name)
    if [[ "$target" == worktree-* ]]; then
      local stripped="${target#worktree-}"
      if [[ -d "$wt_base/$stripped" ]]; then
        echo "$wt_base/$stripped"
        return
      fi
    fi

    return 1
  }

  # Navigate to a worktree by number, name, branch, or special target
  _wt_go() {
    local target="$1"
    local current_wt=$(git rev-parse --show-toplevel 2>/dev/null)

    # - -> previous worktree (or home if not set)
    if [[ "$target" == "-" ]]; then
      if [[ -z "$_WT_PREV" ]]; then
        _WT_PREV="$current_wt"
        cd "$home_repo"
      else
        local old_prev="$_WT_PREV"
        _WT_PREV="$current_wt"
        cd "$old_prev"
      fi
      return
    fi

    # 0 or home -> home repo
    if [[ "$target" == "0" || "$target" == "home" ]]; then
      _WT_PREV="$current_wt"
      cd "$home_repo"
      return
    fi

    # Check if it's the home repo's branch
    local home_branch=$(git -C "$home_repo" branch --show-current 2>/dev/null)
    if [[ "$target" == "$home_branch" ]]; then
      # If we're in home, move the branch to a new worktree
      if [[ "$current_wt" == "$home_repo" ]]; then
        wt new
        return
      fi
      _WT_PREV="$current_wt"
      cd "$home_repo"
      return
    fi

    # Use centralized resolution
    local wt_dir
    wt_dir=$(_wt_resolve_target "$target")

    if [[ -n "$wt_dir" && -d "$wt_dir" ]]; then
      _WT_PREV="$current_wt"
      cd "$wt_dir"
      return
    fi

    # Local branch exists but no worktree -> auto-create
    local branch_name=""
    if git show-ref --verify --quiet "refs/heads/$target"; then
      branch_name="$target"
    elif git show-ref --verify --quiet "refs/heads/worktree-$target"; then
      branch_name="worktree-$target"
    fi

    if [[ -n "$branch_name" ]]; then
      # Derive worktree name: strip worktree- prefix if present
      local wt_name="$branch_name"
      [[ "$wt_name" == worktree-* ]] && wt_name="${wt_name#worktree-}"

      wt_dir="$wt_base/$wt_name"
      mkdir -p "$wt_base"
      git worktree add "$wt_dir" "$branch_name" || return 1
      _WT_PREV="$current_wt"
      cd "$wt_dir"
      return
    fi

    # Remote branch exists -> create worktree tracking remote
    local remote_branch=""
    if git show-ref --verify --quiet "refs/remotes/origin/$target"; then
      remote_branch="$target"
    elif git show-ref --verify --quiet "refs/remotes/origin/worktree-$target"; then
      remote_branch="worktree-$target"
    fi

    if [[ -n "$remote_branch" ]]; then
      local wt_name="$remote_branch"
      [[ "$wt_name" == worktree-* ]] && wt_name="${wt_name#worktree-}"

      wt_dir="$wt_base/$wt_name"
      mkdir -p "$wt_base"
      git worktree add "$wt_dir" -b "$remote_branch" "origin/$remote_branch" || return 1
      _WT_PREV="$current_wt"
      cd "$wt_dir"
      return
    fi

    echo "wt: no such worktree or branch: $target" >&2
    return 1
  }

  case "$1" in
    home)
      _WT_PREV=$(git rev-parse --show-toplevel 2>/dev/null)
      cd "$home_repo"
      ;;

    go)
      [[ -z "$2" ]] && {
        echo "wt go <target>" >&2
        return 1
      }
      _wt_go "$2"
      ;;

    new)
      local name="$2"

      # No name arg -> use current branch name (move from home)
      if [[ -z "$name" ]]; then
        local current_wt=$(git rev-parse --show-toplevel 2>/dev/null)
        [[ "$current_wt" != "$home_repo" ]] && {
          echo "wt: 'wt new' with no name is only allowed from home" >&2
          return 1
        }

        branch=$(git branch --show-current 2>/dev/null)
        [[ -z "$branch" ]] && {
          echo "wt: not on a branch" >&2
          return 1
        }
        [[ "$branch" == "main" ]] && {
          echo "wt: already on main, nothing to move" >&2
          return 1
        }

        # Derive name from branch (strip worktree- prefix if present)
        name="$branch"
        [[ "$name" == worktree-* ]] && name="${name#worktree-}"

        # Move branch from home: switch home to main, then create worktree
        git checkout main || {
          echo "wt: could not checkout main in home" >&2
          return 1
        }

        local wt_dir="$wt_base/$name"
        [[ -d "$wt_dir" ]] && {
          echo "wt: worktree '$name' already exists" >&2
          return 1
        }

        mkdir -p "$wt_base"
        git worktree add "$wt_dir" "$branch" || return 1
        _WT_PREV="$current_wt"
        cd "$wt_dir"
        return
      fi

      # Named worktree: wt new <name>
      [[ "$name" == "home" ]] && {
        echo "wt: 'home' is reserved" >&2
        return 1
      }

      [[ -d "$wt_base/$name" ]] && {
        echo "wt: worktree '$name' already exists" >&2
        return 1
      }

      branch="worktree-$name"

      # If branch worktree-<name> is checked out in home, switch home to main first
      local home_branch=$(git -C "$home_repo" branch --show-current 2>/dev/null)
      if [[ "$branch" == "$home_branch" ]]; then
        local current_wt=$(git rev-parse --show-toplevel 2>/dev/null)
        [[ "$current_wt" != "$home_repo" ]] && {
          echo "wt: branch '$branch' is checked out in home; run from home to move it" >&2
          return 1
        }
        git checkout main || {
          echo "wt: could not checkout main in home" >&2
          return 1
        }
      fi

      local current_wt=${current_wt:-$(git rev-parse --show-toplevel 2>/dev/null)}
      local wt_dir="$wt_base/$name"
      mkdir -p "$wt_base"

      if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$wt_dir" "$branch" || return 1
      else
        git worktree add "$wt_dir" -b "$branch" || return 1
      fi

      _WT_PREV="$current_wt"
      cd "$wt_dir"
      ;;

    rm)
      local delete_branch=false
      [[ "$2" == "-b" ]] && { delete_branch=true; shift; }

      target="$2"
      [[ -z "$target" ]] && {
        echo "wt rm [-b] <target>" >&2
        return 1
      }

      [[ "$target" == "home" || "$target" == "0" ]] && {
        echo "wt: cannot remove home" >&2
        return 1
      }

      local wt_dir
      wt_dir=$(_wt_resolve_target "$target")

      if [[ -z "$wt_dir" || ! -d "$wt_dir" ]]; then
        echo "wt: no such worktree: $target" >&2
        return 1
      fi

      # If currently inside the worktree being removed, cd to home first
      if [[ "$PWD" == "$wt_dir"* ]]; then
        cd "$home_repo"
      fi

      local branch_to_delete=""
      $delete_branch && branch_to_delete=$(_wt_get_branch "$wt_dir")

      git worktree remove "$wt_dir" || return 1
      [[ -n "$branch_to_delete" ]] && git branch -d "$branch_to_delete"
      return 0
      ;;

    list)
      git worktree list
      ;;

    status)
      local current_branch home_branch
      current_branch=$(git branch --show-current 2>/dev/null)
      home_branch=$(git -C "$home_repo" branch --show-current 2>/dev/null)

      local -a worktree_lines other_lines
      local marker location wt_dir dir_name

      # Get sorted worktree names for indexing
      local -a sorted_dirs
      if [[ -d "$wt_base" ]]; then
        sorted_dirs=($(ls -1 "$wt_base" 2>/dev/null | sort))
      fi

      while read -r branch; do
        marker=" "
        location=""

        [[ "$branch" == "$current_branch" ]] && marker="*"

        if [[ "$branch" == "$home_branch" ]]; then
          location="[home]"
          worktree_lines=("$(printf "000000 %s %-20s %s" "$marker" "$branch" "$location")" "${worktree_lines[@]}")
        else
          wt_dir=$(_wt_find_by_branch "$branch")
          if [[ -n "$wt_dir" ]]; then
            dir_name=$(basename "$wt_dir")
            # Find numeric index in sorted dirs
            local idx=0
            for (( i=1; i<=${#sorted_dirs[@]}; i++ )); do
              if [[ "${sorted_dirs[$i]}" == "$dir_name" ]]; then
                idx=$i
                break
              fi
            done
            if (( idx > 0 )); then
              location="[$idx:$dir_name]"
              worktree_lines+=("$(printf "%06d %s %-20s %s" "$idx" "$marker" "$branch" "$location")")
            else
              location="[$dir_name]"
              worktree_lines+=("$(printf "999999 %s %-20s %s" "$marker" "$branch" "$location")")
            fi
          else
            other_lines+=("$(printf "%s %-20s %s" "$marker" "$branch" "$location")")
          fi
        fi
      done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

      # Print worktrees sorted by number
      printf '%s\n' "${worktree_lines[@]}" | sort -n | cut -d' ' -f2-

      # Print other branches
      printf '%s\n' "${other_lines[@]}"
      ;;

    *)
      if [[ -n "$1" ]]; then
        # Shorthand: wt <target> -> wt go <target>
        _wt_go "$1"
        return
      fi

      # No args -> status
      wt status
      ;;
  esac
}
