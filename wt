wt() {
  _wt_usage() {
    cat <<EOF
usage:
  wt [go] <#|branch>   go to worktree (creates if branch exists)
  wt [go] 0|home       go to main repo
  wt [go] -            go to previous worktree
  wt new <branch>      create new branch and worktree
  wt rm <#|branch>     remove worktree
  wt rm -b <#|branch>  remove worktree and delete branch
  wt list              list worktrees (raw)
  wt status            show branches and worktree status
EOF
  }

  # Handle help before git repo check so it works anywhere
  if [[ "$1" == "-h" || "$1" == "--help" || "$1" == "help" ]]; then
    _wt_usage
    return 0
  fi

  local home_repo home_repo_parent repo_name wt_base target branch

  # Get home repo (first worktree is always the main one)
  home_repo=$(git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //')

  [[ -z "$home_repo" ]] && {
    echo "wt: not inside a git repository" >&2
    _wt_usage >&2
    return 1
  }

  home_repo_parent=$(dirname "$home_repo")
  repo_name=$(basename "$home_repo")
  wt_base="$home_repo_parent/${repo_name}-worktrees"

  local config_file="$home_repo/.worktree"

  # Read lines from a section of the config file
  _wt_config_section() {
    local target_section="$1"
    local current_section=""

    [[ -f "$config_file" ]] || return 0

    while IFS= read -r line; do
      [[ -z "$line" || "$line" == \#* ]] && continue

      # Match section headers like [name] or [name] with trailing space
      if [[ "$line" == \[*\]* ]]; then
        current_section="${line#\[}"      # Remove leading [
        current_section="${current_section%%\]*}"  # Remove ] and anything after
        continue
      fi

      [[ "$current_section" == "$target_section" ]] && echo "$line"
    done < "$config_file"
  }

  # Copy files based on [copy] section
  _wt_copy_files() {
    local src="$1" dst="$2"

    # Always copy .worktree itself
    [[ -f "$src/.worktree" ]] && cp "$src/.worktree" "$dst/.worktree"

    _wt_config_section "copy" | while IFS= read -r pattern; do
      # Use zsh globbing which supports **
      local files=("$src"/$~pattern(N))
      for file in "${files[@]}"; do
        [[ -f "$file" ]] || continue
        local rel="${file#$src/}"
        mkdir -p "$dst/$(dirname "$rel")"
        cp "$file" "$dst/$rel"
      done
    done
  }

  # Run commands from a section
  # Substitutes $WT_DIR with actual worktree path before eval
  _wt_run_hooks() {
    local section="$1"
    local cmd
    while IFS= read -r cmd; do
      cmd="${cmd//\$WT_DIR/$wt_dir}"
      eval "$cmd"
    done < <(_wt_config_section "$section")
  }

  # Get next available worktree directory name
  _wt_next_dir() {
    local i=1
    while [[ -d "$wt_base/$repo_name-worktree-$i" ]]; do
      ((i++))
    done
    echo "$repo_name-worktree-$i"
  }

  # Find worktree directory by branch name
  _wt_find_by_branch() {
    local target_branch="$1"
    git worktree list --porcelain | awk -v branch="refs/heads/$target_branch" -v base="$wt_base" '
      /^worktree / { path = substr($0, 10) }
      /^branch / && $2 == branch && index(path, base) == 1 { print path; exit }
    '
  }

  # Get branch name for a worktree path
  _wt_get_branch() {
    local wt_path="$1"
    git worktree list --porcelain | awk -v path="$wt_path" '
      /^worktree / { current = substr($0, 10) }
      /^branch / && current == path { sub("refs/heads/", ""); print $2; exit }
    '
  }

  # Navigate to a worktree by number, branch, or special target
  _wt_go() {
    local target="$1"
    local current_wt=$(git rev-parse --show-toplevel 2>/dev/null)

    # - -> previous worktree (or home if not set)
    if [[ "$target" == "-" ]]; then
      if [[ -z "$_WT_PREV" ]]; then
        _WT_PREV="$current_wt"
        cd "$home_repo"
      else
        local old_prev="$_WT_PREV"
        _WT_PREV="$current_wt"
        cd "$old_prev"
      fi
      return
    fi

    # 0 or home -> home repo
    if [[ "$target" == "0" || "$target" == "home" ]]; then
      _WT_PREV="$current_wt"
      cd "$home_repo"
      return
    fi

    # Check if it's the home repo's branch
    local home_branch=$(git -C "$home_repo" branch --show-current 2>/dev/null)
    if [[ "$target" == "$home_branch" ]]; then
      _WT_PREV="$current_wt"
      cd "$home_repo"
      return
    fi

    local wt_dir=""

    # Try as directory number (e.g., "1" -> "project-worktree-1")
    if [[ "$target" =~ ^[0-9]+$ && -d "$wt_base/$repo_name-worktree-$target" ]]; then
      wt_dir="$wt_base/$repo_name-worktree-$target"
    # Try as full directory name
    elif [[ -d "$wt_base/$target" ]]; then
      wt_dir="$wt_base/$target"
    # Try as branch name (existing worktree)
    else
      wt_dir=$(_wt_find_by_branch "$target")
    fi

    if [[ -n "$wt_dir" && -d "$wt_dir" ]]; then
      _WT_PREV="$current_wt"
      cd "$wt_dir"
      return
    fi

    # Local branch exists but no worktree -> create one
    if git show-ref --verify --quiet "refs/heads/$target"; then
      wt_dir="$wt_base/$(_wt_next_dir)"
      mkdir -p "$wt_base"
      git worktree add "$wt_dir" "$target" || return 1
      _wt_copy_files "$home_repo" "$wt_dir"
      cd "$wt_base"
      _wt_run_hooks "setup"
      _WT_PREV="$current_wt"
      cd "$wt_dir"
      _wt_run_hooks "init"
      return
    fi

    # Remote branch exists but no local branch -> create worktree tracking remote
    if git show-ref --verify --quiet "refs/remotes/origin/$target"; then
      wt_dir="$wt_base/$(_wt_next_dir)"
      mkdir -p "$wt_base"
      git worktree add "$wt_dir" -b "$target" "origin/$target" || return 1
      _wt_copy_files "$home_repo" "$wt_dir"
      cd "$wt_base"
      _wt_run_hooks "setup"
      _WT_PREV="$current_wt"
      cd "$wt_dir"
      _wt_run_hooks "init"
      return
    fi

    echo "wt: no such worktree or branch: $target" >&2
    return 1
  }

  case "$1" in
    home)
      _WT_PREV=$(git rev-parse --show-toplevel 2>/dev/null)
      cd "$home_repo"
      ;;

    go)
      [[ -z "$2" ]] && {
        echo "wt go <target>" >&2
        return 1
      }
      _wt_go "$2"
      ;;

    new)
      branch="$2"
      [[ -z "$branch" ]] && {
        echo "wt new <branch>" >&2
        return 1
      }

      [[ "$branch" == "home" ]] && {
        echo "wt: 'home' is reserved" >&2
        return 1
      }

      local current_wt=$(git rev-parse --show-toplevel 2>/dev/null)
      local wt_dir="$wt_base/$(_wt_next_dir)"
      mkdir -p "$wt_base"

      if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$wt_dir" "$branch" || return 1
      else
        git worktree add "$wt_dir" -b "$branch" || return 1
      fi

      _wt_copy_files "$home_repo" "$wt_dir"
      cd "$wt_base"
      _wt_run_hooks "setup"
      _WT_PREV="$current_wt"
      cd "$wt_dir"
      _wt_run_hooks "init"
      ;;

    rm)
      local delete_branch=false
      [[ "$2" == "-b" ]] && { delete_branch=true; shift; }

      target="$2"
      [[ -z "$target" ]] && {
        echo "wt rm [-b] <target>" >&2
        return 1
      }

      [[ "$target" == "home" ]] && {
        echo "wt: cannot remove home" >&2
        return 1
      }

      local wt_dir=""

      # Try as directory number first
      if [[ "$target" =~ ^[0-9]+$ && -d "$wt_base/$repo_name-worktree-$target" ]]; then
        wt_dir="$wt_base/$repo_name-worktree-$target"
      # Try as full directory name
      elif [[ -d "$wt_base/$target" ]]; then
        wt_dir="$wt_base/$target"
      # Try as branch name
      else
        wt_dir=$(_wt_find_by_branch "$target")
      fi

      if [[ -z "$wt_dir" || ! -d "$wt_dir" ]]; then
        echo "wt: no such worktree: $target" >&2
        return 1
      fi

      # If currently inside the worktree being removed, cd to home first
      if [[ "$PWD" == "$wt_dir"* ]]; then
        cd "$home_repo"
      fi

      local branch_to_delete=""
      $delete_branch && branch_to_delete=$(_wt_get_branch "$wt_dir")

      git worktree remove "$wt_dir" || return 1
      [[ -n "$branch_to_delete" ]] && git branch -d "$branch_to_delete"
      return 0
      ;;

    list)
      git worktree list
      ;;

    status)
      local current_branch home_branch
      current_branch=$(git branch --show-current 2>/dev/null)
      home_branch=$(git -C "$home_repo" branch --show-current 2>/dev/null)

      local -a worktree_lines other_lines
      local marker location wt_dir dir_name wt_num

      while read -r branch; do
        marker=" "
        location=""
        wt_num=""

        [[ "$branch" == "$current_branch" ]] && marker="*"

        if [[ "$branch" == "$home_branch" ]]; then
          location="[0]"
          wt_num="0"
        else
          wt_dir=$(_wt_find_by_branch "$branch")
          if [[ -n "$wt_dir" ]]; then
            dir_name=$(basename "$wt_dir")
            if [[ "$dir_name" == ${repo_name}-worktree-* ]]; then
              wt_num="${dir_name##*-}"
              location="[$wt_num]"
            else
              wt_num="999999"
              location="[$dir_name]"
            fi
          fi
        fi

        if [[ -n "$wt_num" ]]; then
          worktree_lines+=("$(printf "%06d %s %-20s %s" "$wt_num" "$marker" "$branch" "$location")")
        else
          other_lines+=("$(printf "%s %-20s %s" "$marker" "$branch" "$location")")
        fi
      done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

      # Print worktrees sorted by number
      printf '%s\n' "${worktree_lines[@]}" | sort -n | cut -d' ' -f2-

      # Print other branches
      printf '%s\n' "${other_lines[@]}"
      ;;

    *)
      # Shorthand: wt <target> -> wt go <target>
      if [[ -n "$1" ]]; then
        _wt_go "$1" && return
      fi

      _wt_usage >&2
      return 1
      ;;
  esac
}
